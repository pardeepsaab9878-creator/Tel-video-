# Environment variables for Telegram Video Downloader Bot
# Copy this file to .env and fill in your values
# NEVER commit your actual .env file to GitHub!

# Telegram Bot Token obtained from @BotFather (e.g., 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
BOT_TOKEN=your_bot_token_here

# Your numeric Telegram user ID for admin commands (e.g., 123456789)
ADMIN_USER_ID=your_telegram_user_id_here

# Maximum file size to download in Megabytes (Telegram Bot API limit is 50MB)
MAX_FILE_SIZE_MB=50

# Cooldown between download requests per user in seconds
RATE_LIMIT_SECONDS=10

# Request timeout in seconds
REQUEST_TIMEOUT_SECONDS=60
